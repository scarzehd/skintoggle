{
	"schemaVersion": 1,
	"id": "skintoggle",
	"version": "${version}",
	"name": "SkinToggle",
	"description": "A mod that dynamically hides and shows skin layers with the goal of being fully configurable.",
	"authors": [
		"S. C. Arzehd"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/skintoggle/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.scarzehd.skintoggle.SkinToggle"
		]
	},
	"mixins": [
		"skintoggle.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.12",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
